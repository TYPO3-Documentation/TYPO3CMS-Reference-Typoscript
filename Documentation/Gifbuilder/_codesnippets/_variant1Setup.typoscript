lib.shadowImage = IMAGE
lib.shadowImage {
  file = GIFBUILDER
  file {
    XY = [10.w],[10.h]
    format = jpg
    quality = 88

    10 = IMAGE
    10 {
      # Background image, as wide as the result
      file = fileadmin/shadow.png
      file.width = 320
    }

    # Scale background image
    15 = SCALE
    15 {
      width = [10.w]
      # Background image is 20 pixels higher than the real image
      height = [20.h]+20
    }

    # Put real image on top of it
    20 = IMAGE
    20 {
      # The real image is 20 pixels narrower than the background image
      file = fileadmin/image.jpg
      file.width = 300
      # Inserted at offset 10,10
      offset = 10,10
    }
  }
}
