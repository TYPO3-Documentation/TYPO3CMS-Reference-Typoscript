{
    "name": "myvendor/my-extension",
    "type": "typo3-cms-extension",
    "description": "Example extension of the TypoScript Reference: the records that its examples render",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "dev-main as 14.3",
        "typo3/cms-frontend": "dev-main as 14.3"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\MyExtension\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "my_extension"
        }
    }
}
