tt_content {
  myextension_dataprocmenu =< lib.contentElement
  myextension_dataprocmenu {
    templateName = DataProcMenu
    dataProcessing.10 = menu
    dataProcessing.10 {
      levels = 2
      as = headerMenu
      expandAll = 1
      includeSpacer = 1
      titleField = nav_title // title
      dataProcessing {
        10 = files
        10 {
          references.fieldName = media
        }
      }
    }
  }
}
