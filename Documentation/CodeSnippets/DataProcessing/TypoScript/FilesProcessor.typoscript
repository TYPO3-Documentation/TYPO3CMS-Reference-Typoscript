tt_content {
  myextension_dataprocfiles =< lib.contentElement
  myextension_dataprocfiles {
    templateName = DataProcFiles
    dataProcessing.10 = files
    dataProcessing.10 {
      as = images
      references.fieldName = image
      references.table = tt_content
      sorting = title
      sorting.direction = descending
    }
  }
}
