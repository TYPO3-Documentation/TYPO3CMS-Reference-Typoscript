tt_content {
  myextension_dataproccsv =< lib.contentElement
  myextension_dataproccsv {
    templateName = DataProcCsv
    dataProcessing.10 = comma-separated-value
    dataProcessing.10 {
      if.isTrue.field = bodytext
      fieldName = bodytext
      fieldDelimiter.field = tx_myextension_separator
      fieldEnclosure = "
      maximumColumns.field = imagecols
      as = myTable
    }
  }
}
