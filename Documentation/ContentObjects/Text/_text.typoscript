10 = CONTENT
10 {
  table = tt_content
  select {
    where.dataWrap = irre_parentid  = {field:uid}
    begin = 0
  }

  renderObj = COA
  renderObj {
    stdWrap.if.isTrue.data = field:bodytext
    10 = TEXT
    10.value.field = bodytext
    10.stdWrap.parseFunc < lib.parseFunc_RTE
    10.stdWrap.dataWrap = <div>|</div>
  }
}
